#!/usr/bin/env sh
# 整树检出后同步子模块：判定在 qtfounder git hook run post-checkout。
# 第三个参数为 0 是单文件检出，跳过；找不到 CLI 也跳过。

[ "${3:-0}" = "1" ] || exit 0
[ "${QT_SUBMODULE_SYNC:-}" = "1" ] && exit 0
command -v qtfounder >/dev/null 2>&1 || exit 0

hooks=$(CDPATH= cd "$(dirname "$0")" && pwd)
exec qtfounder git hook run post-checkout --root "$(dirname "$hooks")"

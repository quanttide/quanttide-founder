#!/usr/bin/env sh
# 写入闸门：判定在 qtfounder git hook run pre-commit。
# 找不到 CLI 时不查，与旧闸门的降级一致。

hooks=$(CDPATH= cd "$(dirname "$0")" && pwd)
root=$(dirname "$hooks")

if ! command -v qtfounder >/dev/null 2>&1; then
  echo "闸门：找不到 qtfounder，这次不查" >&2
  exit 0
fi

exec qtfounder git hook run pre-commit --root "$root"
